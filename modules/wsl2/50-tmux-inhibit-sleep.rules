// Let thomaz hold sleep inhibitors from any session, not only the active
// graphical one, so a tmux server started over ssh can block suspend
// (see the "Sleep inhibitor" section of tmux.conf beside this file).
// Install: sudo install -m644 50-tmux-inhibit-sleep.rules /etc/polkit-1/rules.d/
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.login1.inhibit-block-sleep" ||
         action.id == "org.freedesktop.login1.inhibit-delay-sleep") &&
        subject.user == "thomaz") {
        return polkit.Result.YES;
    }
});

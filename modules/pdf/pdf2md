#!/usr/bin/env bash
# pdf2md <file.pdf>: prints a PDF as Markdown (pdf_to_markdown.py, on the venv
# Install-PdfTools.ps1 creates). Called by pdfcat when piped and by NeoVim on
# opening a *.pdf; no binding.
python="$HOME/.local/share/pdf-tools/bin/python"
if [ ! -x "$python" ]; then
  echo "pdf2md: not installed, run: pwsh ~/.modules/pdf/Install-PdfTools.ps1" >&2
  exit 1
fi
exec "$python" -I "$(dirname "$(readlink -f "$0")")/pdf_to_markdown.py" "$@"
